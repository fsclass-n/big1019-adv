# 저장소 루트의 .env 양식 — 복사해서 .env 로 이름을 바꾸고 필요한 값만 채우세요.
# .env 는 .gitignore 에 등록되어 Git 에 올라가지 않습니다. (이 .env.example 에는 실제 값을 쓰지 마세요)

# ── p01·p02 생성형 AI ──────────────────────────────
# Gemini (무료 키 발급: https://aistudio.google.com/apikey)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
# OpenAI (유료: https://platform.openai.com/api-keys) — p01/01_openai_chatbot
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# ── p02/04 메일 발송 (비워 두면 내 PC 테스트 메일 서버 사용) ──
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_SENDER=

# ── p03/03, p04/ch06 데이터베이스 (TiDB / MySQL) ─────
DB_HOST=gateway01.ap-northeast-1.prod.aws.tidbcloud.com
DB_PORT=4000
DB_USERNAME=사용자이름
DB_PASSWORD=비밀번호
DB_DATABASE=mydb

# ── p04/ch06 ex05 JWT 서명 키 (생성: python -c "import secrets; print(secrets.token_hex(32))") ──
JWT_SECRET_KEY=

# ── p04/ch03 AWS SageMaker (실제 AWS 실행 시에만, 요금 발생 주의) ──
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=ap-northeast-2
SAGEMAKER_ROLE_ARN=
